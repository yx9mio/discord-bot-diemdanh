# Runtime (optional)
LOG_LEVEL=info
PORT=8080
TZ=Asia/Ho_Chi_Minh

# Supabase CLI — get from https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_xxx
